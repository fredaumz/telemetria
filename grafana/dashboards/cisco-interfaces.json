 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Estado",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Uma interface: estado do protocolo (UP / DOWN / ADMIN DOWN). Várias interfaces ou All: quantas estão em cada estado. DOWN não inclui as desligadas com shutdown.",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#8e8d86",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Estado"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "UP",
            "color": "#0ca30c"
           },
           "0": {
            "text": "DOWN",
            "color": "#d03b3b"
           },
           "2": {
            "text": "ADMIN DOWN",
            "color": "#8e8d86"
           },
           "3": {
            "text": "OUTRO",
            "color": "#fab219"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "UP"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#0ca30c",
           "value": null
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "DOWN"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#0ca30c",
           "value": null
          },
          {
           "color": "#d03b3b",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ADMIN DOWN"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#8e8d86",
           "value": null
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "orientation": "vertical",
    "wideLayout": true
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max(ifbrief_line_state{source=~\"$router\",interface_name=~\"$interface\"}) and on() (count(ifbrief_line_state{source=~\"$router\",interface_name=~\"$interface\"}) == 1)",
     "legendFormat": "Estado"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "(count(ifbrief_line_state{source=~\"$router\",interface_name=~\"$interface\"} == 1) or vector(0)) and on() (count(ifbrief_line_state{source=~\"$router\",interface_name=~\"$interface\"}) > 1)",
     "legendFormat": "UP"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "(count((ifbrief_line_state{source=~\"$router\",interface_name=~\"$interface\"} == 0) and (ifbrief_state{source=~\"$router\",interface_name=~\"$interface\"} != 2)) or vector(0)) and on() (count(ifbrief_line_state{source=~\"$router\",interface_name=~\"$interface\"}) > 1)",
     "legendFormat": "DOWN"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "(count(ifbrief_state{source=~\"$router\",interface_name=~\"$interface\"} == 2) or vector(0)) and on() (count(ifbrief_line_state{source=~\"$router\",interface_name=~\"$interface\"}) > 1)",
     "legendFormat": "ADMIN DOWN"
    }
   ]
  },
